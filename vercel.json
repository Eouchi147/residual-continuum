    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/ask.js": {
      "maxDuration": 45
    },
    "api/draft.js": {
      "maxDuration": 300
    },
    "api/studio.js": {
      "maxDuration": 300,
      "includeFiles": "studio/plan.json"
    },
    "api/hit.js": {
      "maxDuration": 10
    }
  },
  "fluid": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/studio/callback/:net",
      "destination": "/api/studio?action=callback&net=:net"
    }
  ]
}
