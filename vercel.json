{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/draft",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/draft",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/draft",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/draft",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/draft",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/studio?action=due",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/studio?action=due",
